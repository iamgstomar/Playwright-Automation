
pipeline {
    agent any

    parameters {
        choice(
            name: 'MODULE',
            choices: ['Departments', 'Login', 'ALL'],
            description: 'Which module to test'
        )

        string(
            name: 'LABEL',
            defaultValue: '',
            description: 'Build label shown in Allure Trend. Leave blank for auto.'
        )

        booleanParam(
            name: 'REPORT_ONLY',
            defaultValue: false,
            description: 'Skip pytest and regenerate the Allure report from Excel'
        )
    }

    environment {
        PYTHON_HOME   = 'C:\\Users\\Dell\\AppData\\Local\\Programs\\Python\\Python313'
        VENV_PYTHON   = 'venv\\Scripts\\python.exe'
        ALLURE_RESULTS = 'allure-results'
        ALLURE_REPORT  = 'allure-report'
    }

    options {
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        skipDefaultCheckout(true)
    }

    stages {

        stage('Checkout Latest Code') {
            steps {
                checkout scm

                bat '''
                    echo ===== Git Revision =====
                    git log -1 --oneline

                    echo ===== Cleaning Untracked Files =====
                    git clean -fd

                    echo ===== Git Status =====
                    git status --short
                '''
            }
        }

        stage('Setup Environment') {
            steps {
                withCredentials([
                    file(credentialsId: 'qa-config-yaml', variable: 'CONFIG_FILE'),
                    file(credentialsId: 'qa-excel', variable: 'EXCEL_FILE')
                ]) {
                    bat '''
                        if not exist "config" mkdir "config"

                        echo Updating Jenkins configuration files...
                        copy /Y "%CONFIG_FILE%" "config\\config.yaml"
                        if errorlevel 1 exit /b 1

                        copy /Y "%EXCEL_FILE%" "QA_Test_Cases.xlsx"
                        if errorlevel 1 exit /b 1
                    '''
                }

                bat '''
                    if not exist "%VENV_PYTHON%" (
                        echo Creating Python virtual environment...
                        "%PYTHON_HOME%\\python.exe" -m venv venv
                        if errorlevel 1 exit /b 1
                    )

                    "%VENV_PYTHON%" --version

                    "%VENV_PYTHON%" -m pip install --upgrade pip
                    if errorlevel 1 exit /b 1

                    "%VENV_PYTHON%" -m pip install -r requirements.txt
                    if errorlevel 1 exit /b 1

                    "%VENV_PYTHON%" -m playwright install chromium
                    if errorlevel 1 exit /b 1
                '''
            }
        }

        stage('Run Tests') {
            when {
                expression { !params.REPORT_ONLY }
            }

            steps {
                script {
                    // Start with a completely fresh pytest Allure results directory.
                    bat '''
                        if exist "%ALLURE_RESULTS%" (
                            rmdir /S /Q "%ALLURE_RESULTS%"
                        )

                        mkdir "%ALLURE_RESULTS%"
                    '''

                    catchError(
                        buildResult: 'UNSTABLE',
                        stageResult: 'FAILURE'
                    ) {
                        if (params.MODULE == 'ALL') {
                            bat '''
                                "%VENV_PYTHON%" -m pytest -v --alluredir="%ALLURE_RESULTS%"
                            '''
                        }
                        else if (params.MODULE == 'Departments') {
                            bat '''
                                "%VENV_PYTHON%" -m pytest -v -m "departments" --alluredir="%ALLURE_RESULTS%"
                            '''
                        }
                        else if (params.MODULE == 'Login') {
                            bat '''
                                "%VENV_PYTHON%" -m pytest -v -m "login" --alluredir="%ALLURE_RESULTS%"
                            '''
                        }
                    }
                }
            }

            post {
                always {
                    echo 'Pytest execution completed. Allure results are generated by pytest.'
                }
            }
        }

        stage('Generate Allure Results from Excel') {
            when {
                expression { params.REPORT_ONLY }
            }

            steps {
                echo 'REPORT_ONLY enabled: generating Allure results from Excel.'

                bat '''
                    if not exist "%VENV_PYTHON%" (
                        echo ERROR: Python virtual environment not found.
                        exit /b 1
                    )

                    if not exist "%ALLURE_RESULTS%" (
                        mkdir "%ALLURE_RESULTS%"
                    )

                    if "%MODULE%"=="ALL" (
                        "%VENV_PYTHON%" tools\\excel_to_allure.py --all --label "%LABEL%"
                    ) else (
                        "%VENV_PYTHON%" tools\\excel_to_allure.py --sheet "%MODULE%" --label "%LABEL%"
                    )

                    if errorlevel 1 exit /b 1
                '''
            }
        }

        stage('Publish Report') {
            steps {
                echo 'Publishing Allure report in Jenkins.'

                allure([
                    includeProperties: true,
                    jdk: '',
                    results: [[path: "${ALLURE_RESULTS}"]],
                    report: "${ALLURE_REPORT}",
                    reportBuildPolicy: 'ALWAYS'
                ])
            }
        }
    }

    post {
        success {
            echo 'Puffin QA Automation pipeline completed successfully.'
        }

        unstable {
            echo 'Puffin QA Automation completed with unstable test results.'
        }

        failure {
            echo 'Puffin QA Automation pipeline failed. Please check the console output.'
        }

        always {
            echo 'Cleaning Python virtual environment.'

            cleanWs(
                patterns: [
                    [pattern: 'venv/**', type: 'INCLUDE']
                ]
            )
        }
    }
}